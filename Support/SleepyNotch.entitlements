<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Used only when signing with a Developer ID (hardened runtime, for
	     notarization). Each one is something the app already asks the user
	     for; without them the hardened runtime would block it silently. -->
	<!-- Controlling Music and Spotify, and System Events (Dark Mode). -->
	<key>com.apple.security.automation.apple-events</key>
	<true/>
	<!-- Voice waves, dictation. -->
	<key>com.apple.security.device.audio-input</key>
	<true/>
	<!-- Calendar page and meeting reminders. -->
	<key>com.apple.security.personal-information.calendars</key>
	<true/>
</dict>
</plist>
